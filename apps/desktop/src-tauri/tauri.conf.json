{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameHost ONE",
  "mainBinaryName": "GameHostONE",
  "version": "0.5.1",
  "identifier": "com.gamehost.one",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GameHost ONE",
        "width": 1200,
        "height": 800,
        "devtools": false,
        "decorations": false,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; connect-src 'self' https://api.github.com https://api.ipify.org https://api.adoptium.net https://piston-meta.mojang.com https://api.papermc.io https://maven.minecraftforge.net https://meta.fabricmc.net https://cdn.modrinth.com https://edge.forgecdn.net https://mediafilez.forgecdn.net https://discord.com https://discordapp.com; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:;",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "GameHost ONE",
    "homepage": "https://github.com/Adlikkk/gamehost-one-app",
    "copyright": "Copyright (c) 2026 GameHost ONE",
    "license": "MIT",
    "shortDescription": "Local-first Minecraft server control.",
    "longDescription": "Install GameHost ONE to create, import, and manage local Minecraft servers from a Windows desktop app.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "GameHost ONE",
        "installerHooks": "nsis/hooks.nsh"
      },
      "wix": {
        "upgradeCode": "82fa496d-b0a3-5d6e-984a-0ca1a77c6895",
        "language": "en-US",
        "bannerPath": "icons/installer-banner.bmp",
        "dialogImagePath": "icons/installer-dialog.bmp"
      }
    }
  }
}
